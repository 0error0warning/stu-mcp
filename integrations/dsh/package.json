{
  "name": "dsh-stu-mcp",
  "version": "0.1.0",
  "description": "STU MCP · 汕头大学校园工具：连接状态、功能目录与共用设置入口",
  "license": "MIT",
  "main": "index.cjs",
  "exports": { ".": "./index.cjs", "./client": "./client.js", "./package.json": "./package.json" },
  "files": ["index.cjs", "client.js", "cordis.patch.yml", "README.md"],
  "engines": { "dsh": "0.2.1-rc.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  }
}
